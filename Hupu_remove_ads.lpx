#!name = 虎扑去广告
#!desc = 去除虎扑 App 广告：拦截 adlwai.com 广告域名，对 goblin.hupu.com 的广告接口（interfaceAd/getOther）返回空广告列表。需要信任证书并开启 MitM 解密。
#!author = <你的名字>
#!tag = 去广告, 虎扑
#!loon_version = 3.5.1(983)
#!date = 2026-10-30

[Rule]
# 广告域名直接拒绝
DOMAIN-SUFFIX,adlwai.com,REJECT
# 广告接口若走 QUIC/HTTP3，先强制回落到 TCP（必须放在 DIRECT 之前，否则 QUIC 会先命中 DIRECT 而拦不到）
AND,((DOMAIN-SUFFIX,goblin.hupu.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,goblin.hupu.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
# 广告接口域名走直连，便于 MitM 解密（TCP 流量在此命中）
DOMAIN-SUFFIX,goblin.hupu.com,DIRECT

[Rewrite]
# 广告接口返回空广告列表
response if ${url} ~= /^https?:\/\/goblin\.hupu\.com\/\d+\/[\d.]+\/interfaceAd\/getOther/ then response.body.mock("json", `{"ad_code":-41,"show_type":0,"ads":[]}`, 200)

[Mitm]
hostname = goblin.hupu.com
