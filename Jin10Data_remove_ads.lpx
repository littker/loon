#!name = 金十数据去开屏广告
#!desc = 去除金十数据 App 开屏广告：对广告接口返回 200 空 JSON，让 App 判定「今天无广告」直接跳过。需要信任证书并开启 MitM 解密。注意：本版只拦 /ad2/opening，若重开后又出现广告，把规则里的 ad2/opening 改成 ad\d/ 即可覆盖所有广告版本。
#!author = <你的名字>
#!tag = 去广告, 金十数据
#!loon_version = 3.5.1(983)
#!date = 2026-10-30

[Rule]
AND,((DOMAIN,jad-api.jin10.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,jad-api.jin10.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/jad-api\.jin10\.com\/ad2\/opening/i then reject_dict(200)

[Mitm]
hostname = jad-api.jin10.com
